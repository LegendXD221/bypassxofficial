# Required Discord values
BOT_TOKEN=
CLIENT_ID=
# Render provides PORT automatically; local development defaults to 10000.
PORT=10000
# Neon Postgres connection string. If omitted, local JSON storage is used for development.
DATABASE_URL=
# Optional: deploy slash commands to one guild immediately while developing
DISCORD_GUILD_ID=
# Comma-separated Discord user IDs allowed to manage BypassX
OWNER_USER_IDS=
# Optional comma-separated guild IDs to authorize on first boot
DEFAULT_AUTHORIZED_GUILD_IDS=
AUTO_BYPASS_COOLDOWN_SECONDS=15
AUTO_BYPASS_MAX_URLS_PER_MESSAGE=1

# Alysse endpoint from https://alysse.top/api
ALYSSE_API_URL=https://alysse.top/api/bypass
# Built-in fallback providers, tried after Alysse
USEBYPASS_API_URL=https://usebypass.com/api/v1/bypass
USEBYPASS_API_TOKEN=
OMEGATECH_API_URL=https://api.omegatech.app/api/tools/All-bypass

# Optional JSON array. Store env var names, not secrets, in authEnv.
# Example: [{"name":"My fallback","endpoint":"https://example.com/bypass","authEnv":"MY_FALLBACK_TOKEN"}]
BYPASSX_FALLBACK_APIS=[]
